+#ifdef __APPLE__
+/* One line to stderr, without stdio: called from signal handlers. */
+static void warzag_sig_report( const char *what, int sig, ULONG_PTR pc, ULONG_PTR addr )
+{
+    static const char hex[] = "0123456789abcdef";
+    char buf[192];
+    size_t n = 0;
+    const char *p;
+    int field;
+    ULONG_PTR vals[3];
+
+    for (p = "warzag[wz-n-0011]: "; *p && n < sizeof(buf); p++) buf[n++] = *p;
+    for (p = what; *p && n < sizeof(buf) - 64; p++) buf[n++] = *p;
+    if (n < sizeof(buf) - 48) { buf[n++] = ' '; buf[n++] = 's'; buf[n++] = 'i'; buf[n++] = 'g'; buf[n++] = '='; }
+    if (sig >= 100) buf[n++] = '0' + (sig / 100) % 10;
+    if (sig >= 10)  buf[n++] = '0' + (sig / 10) % 10;
+    buf[n++] = '0' + sig % 10;
+
+    vals[0] = pc; vals[1] = addr; vals[2] = (ULONG_PTR)pthread_self();
+    for (field = 0; field < 3; field++)
+    {
+        int shift;
+        const char *label = field == 0 ? " pc=0x" : field == 1 ? " addr=0x" : " thread=0x";
+        for (p = label; *p && n < sizeof(buf); p++) buf[n++] = *p;
+        for (shift = (int)(sizeof(ULONG_PTR) * 8 - 4); shift >= 0 && n < sizeof(buf); shift -= 4)
+            buf[n++] = hex[(vals[field] >> shift) & 0xf];
+    }
+    if (n < sizeof(buf)) buf[n++] = '\n';
+    write( 2, buf, n );
+}
+
+/* A signal on a thread that is not, or no longer, a running Wine thread: one without Wine thread data (a native
+ * thread, or a Wine thread whose TSD keys libpthread has cleared), or one that recorded itself in
+ * pthread_exit_wrapper() and runs its TSD destructors (its server fds are closed, so it must not run Windows code
+ * again). Returns FALSE for any other thread. Otherwise returns TRUE, and the caller must return from the handler:
+ *  - retry: virtual_handle_fault() consumed a guard page, so the access is retried;
+ *  - may_redirect (SIGSEGV, SIGBUS, SIGILL) in a thread in teardown: it resumes in warzag_exit_after_teardown_fault();
+ *  - anything else (a native thread's fault; SIGTRAP, SIGABRT or SIGFPE in teardown, from abort(), __builtin_trap()
+ *    or os_crash(), which must stay fatal, and Apple's abort() blocks nearly every signal in every thread before its
+ *    final brk): the signal is reset to SIG_DFL and raised again, so the process crashes as it would without Wine. */
+static BOOL warzag_fault_outside_wine( struct thread_data *data, int sig, siginfo_t *siginfo, ucontext_t *sigcontext,
+                                       BOOL may_redirect, BOOL retry )
+{
+    ULONG_PTR sp = (ULONG_PTR)SP_sig(sigcontext), frame = 0;
+    struct thread_data *block = NULL;
+    struct sigaction act;
+    int slot;
+
+    /* fast path: a running Wine thread that faults outside its kernel and signal stacks is in Windows code */
+    if (data && !is_inside_syscall( data, sp ) && !is_inside_signal_stack( data, (void *)sp )) return FALSE;
+    slot = warzag_thread_in_teardown( data, sp, (ULONG_PTR)&frame, &frame, &block );
+    if (!slot && data) return FALSE;
+    if (retry) return TRUE;
+
+    if (slot && may_redirect)
+    {
+        warzag_sig_report( "exiting-thread fault in a TSD destructor, finishing teardown",
+                           sig, PC_sig(sigcontext), (ULONG_PTR)siginfo->si_addr );
+        SP_sig(sigcontext) = (frame - 256) & ~(ULONG_PTR)15;  /* below pthread_exit_wrapper()'s frame, same stack */
+        PC_sig(sigcontext) = (ULONG_PTR)warzag_exit_after_teardown_fault;
+        REGn_sig(0, sigcontext) = slot - 1;
+        FP_sig(sigcontext) = 0;
+        LR_sig(sigcontext) = 0;
+        /* resume with the fault signals unblocked (a fault inside a signal handler has them blocked), and tell the
+         * kernel whether the new SP is on the thread's signal stack */
+        sigdelset( &sigcontext->uc_sigmask, SIGSEGV );
+        sigdelset( &sigcontext->uc_sigmask, SIGBUS );
+        sigdelset( &sigcontext->uc_sigmask, SIGILL );
+        sigdelset( &sigcontext->uc_sigmask, SIGTRAP );
+        sigdelset( &sigcontext->uc_sigmask, SIGFPE );
+        sigcontext->uc_onstack = is_inside_signal_stack( block, (void *)SP_sig(sigcontext) ) ? 1 : 0;
+        return TRUE;
+    }
+
+    warzag_sig_report( slot ? "fatal signal in an exiting thread, crashing"
+                            : "fault on a thread with no Wine data, crashing",
+                       sig, PC_sig(sigcontext), (ULONG_PTR)siginfo->si_addr );
+    act.sa_handler = SIG_DFL;
+    sigemptyset( &act.sa_mask );
+    act.sa_flags = 0;
+    sigaction( sig, &act, NULL );
+    /* Blocked inside this handler, the signal is taken with SIG_DFL as soon as the handler returns, even when the
+     * faulting instruction would not fault again. pthread_kill() refuses a thread inside pthread_exit() (ESRCH): there
+     * a brk faults again anyway, and a sent SIGABRT/SIGFPE goes to the process. */
+    if (pthread_kill( pthread_self(), sig ) && (sig == SIGABRT || sig == SIGFPE)) kill( getpid(), sig );
+    return TRUE;
+}
