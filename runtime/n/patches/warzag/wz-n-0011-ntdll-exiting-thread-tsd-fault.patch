+#ifdef __APPLE__
+/* Finish a thread's exit when one of its pthread TSD destructors faults.
+ *
+ * After pthread_exit_wrapper() closes the thread's server fds and calls pthread_exit(), only libpthread's TSD
+ * destructors run on the thread, in rounds (PTHREAD_DESTRUCTOR_ITERATIONS): the keys made by pthread_key_create()
+ * (256..767) in index order, then the static keys of system libraries (10..255, the Objective-C GC keys 80..89 last),
+ * each slot cleared before its destructor runs. thread_data_key and the WINE_TEB_IN_TSD teb key are dynamic keys
+ * without a destructor, made by virtual_init(), so the destructors of later keys (the Objective-C autorelease pool's
+ * static key) run with get_thread_data() == NULL. A fault in a destructor must neither dereference NULL thread data
+ * nor return from NtTerminateThread into Windows code: signal_arm64.c sends the thread to
+ * warzag_exit_after_teardown_fault().
+ *
+ * Each exiting thread records pthread_self(), its thread data block (which holds its kernel stack and its signal
+ * stack) and pthread_exit_wrapper()'s frame. exit_thread() forgets the entry once pthread_join() has reaped the
+ * thread, before the block is freed, as its pthread_t can be reused at once. A signal handler cannot take a lock: it
+ * only reads the ring, and trusts an entry only when it runs on that entry's signal stack and the fault SP lies below
+ * the recorded frame in the same block. */
+
+#define WARZAG_TEARDOWN_RING        256u   /* power of two; exit_thread() serializes exits, a few slots are in use */
+#define WARZAG_TEARDOWN_MAX_ROUNDS  64     /* after this many faults of one thread, clear every key */
+#define WARZAG_TSD_STATIC_FIRST     10     /* libpthread's own keys are 0..9 */
+#define WARZAG_TSD_DYNAMIC_FIRST    256    /* pthread_key_create() hands out keys from here */
+#define WARZAG_TSD_DYNAMIC_END      (256 + 512)  /* PTHREAD_KEYS_MAX == 512 */
+#define WARZAG_TSD_GC_FIRST         80     /* __PTK_FRAMEWORK_GC_KEY0..9: destroyed after all the others */
+#define WARZAG_TSD_GC_END           90
+
+struct warzag_teardown_entry
+{
+    pthread_t volatile           thread;  /* published last; 0 when free or when the thread was reaped */
+    struct thread_data *volatile data;    /* the thread's data block */
+    ULONG_PTR volatile           frame;   /* pthread_exit_wrapper()'s frame address */
+    ULONG volatile               seq;     /* recording order: the newest matching entry wins */
+    int volatile                 rounds;  /* teardown faults handled for this thread */
+};
+static struct warzag_teardown_entry warzag_teardown_ring[WARZAG_TEARDOWN_RING];
+static LONG warzag_teardown_seq;
+
+void warzag_record_thread_teardown( struct thread_data *data, void *frame )
+{
+    ULONG seq = (ULONG)InterlockedIncrement( &warzag_teardown_seq );
+    struct warzag_teardown_entry *e = &warzag_teardown_ring[seq & (WARZAG_TEARDOWN_RING - 1)];
+
+    e->thread = 0;
+    __sync_synchronize();
+    e->data   = data;
+    e->frame  = (ULONG_PTR)frame;
+    e->seq    = seq;
+    e->rounds = 0;
+    __sync_synchronize();
+    e->thread = pthread_self();
+}
+
+/* Called by exit_thread() once pthread_join() has reaped the thread that owned data, before its block is freed. */
+void warzag_forget_thread_teardown( struct thread_data *data )
+{
+    unsigned int i;
+
+    for (i = 0; i < WARZAG_TEARDOWN_RING; i++)
+    {
+        struct warzag_teardown_entry *e = &warzag_teardown_ring[i];
+        pthread_t thread = e->thread;
+
+        if (thread && e->data == data)
+            InterlockedCompareExchangePointer( (void *volatile *)&e->thread, NULL, (void *)thread );
+    }
+}
+
+/* Whether the current thread is in teardown, from a signal handler: async-signal-safe, plain reads of the ring. sp is
+ * the fault's SP, handler_sp an address on the handler's own stack, data get_thread_data() (when set, the entry must
+ * be that block). Returns the newest matching slot + 1 with its frame and block, or 0. */
+int warzag_thread_in_teardown( struct thread_data *data, ULONG_PTR sp, ULONG_PTR handler_sp, ULONG_PTR *frame_ret,
+                               struct thread_data **block_ret )
+{
+    pthread_t self = pthread_self();
+    ULONG best_seq = 0;
+    int best = 0;
+    unsigned int i;
+
+    for (i = 0; i < WARZAG_TEARDOWN_RING; i++)
+    {
+        struct warzag_teardown_entry *e = &warzag_teardown_ring[i];
+        struct thread_data *block;
+        ULONG_PTR frame, lo, hi;
+        ULONG seq;
+
+        if (!e->thread || !pthread_equal( e->thread, self )) continue;
+        __sync_synchronize();
+        block = e->data;
+        frame = e->frame;
+        seq   = e->seq;
+        if (!block || (data && block != data)) continue;
+        /* Wine gives each thread its own signal stack inside its data block: running on it proves the block is ours */
+        if (!is_inside_signal_stack( block, (void *)handler_sp )) continue;
+        lo = (ULONG_PTR)block->signal_stack;
+        hi = (ULONG_PTR)get_kernel_stack( block ) + kernel_stack_size;
+        if (frame >= hi || frame < lo + page_size || sp < lo || sp >= frame) continue;
+        if (best && (LONG)(seq - best_seq) <= 0) continue;
+        best = i + 1;
+        best_seq = seq;
+        *frame_ret = frame;
+        *block_ret = block;
+    }
+    return best;
+}
+
+static BOOL warzag_clear_tsd_key( int key )
+{
+    return pthread_getspecific( (pthread_key_t)key ) && !pthread_setspecific( (pthread_key_t)key, NULL );
+}
+
+/* The signal handler sends the thread here (slot: the entry it matched), on pthread_exit_wrapper()'s stack with the
+ * fault signals unblocked. Clear the first TSD key that libpthread would still visit and that holds a value, then
+ * call pthread_exit() again, which starts the destructor rounds over. That key is the faulting destructor's own when
+ * the destructor put a value back (AutoreleasePoolPage::tls_dealloc reinstates the hot page while it pops), otherwise
+ * the next one, whose destructor is skipped: a leak in an exiting thread, but a destructor that faulted never runs
+ * twice. After WARZAG_TEARDOWN_MAX_ROUNDS faults of the thread every key is cleared, so the thread always exits. */
+void DECLSPEC_NORETURN warzag_exit_after_teardown_fault( unsigned int slot )
+{
+    struct warzag_teardown_entry *e = &warzag_teardown_ring[slot & (WARZAG_TEARDOWN_RING - 1)];
+    BOOL all = ++e->rounds >= WARZAG_TEARDOWN_MAX_ROUNDS;
+    int key;
+
+    /* libpthread's visit order: dynamic keys, static keys but the GC ones, GC keys */
+    for (key = WARZAG_TSD_DYNAMIC_FIRST; key < WARZAG_TSD_DYNAMIC_END; key++)
+        if (warzag_clear_tsd_key( key ) && !all) goto done;
+    for (key = WARZAG_TSD_STATIC_FIRST; key < WARZAG_TSD_DYNAMIC_FIRST; key++)
+        if ((key < WARZAG_TSD_GC_FIRST || key >= WARZAG_TSD_GC_END) && warzag_clear_tsd_key( key ) && !all) goto done;
+    for (key = WARZAG_TSD_GC_FIRST; key < WARZAG_TSD_GC_END; key++)
+        if (warzag_clear_tsd_key( key ) && !all) goto done;
+done:
+    pthread_exit( NULL );
+}
+#endif  /* __APPLE__ */
