+
+  /* For a call that writes an owned handle, such as the NSError out-parameters winemetal.so returns retained. The
+     current value is released first: one Reference can take the errors of several calls, and a call that succeeds
+     writes 0. */
+  obj_handle_t *
+  releaseAndGetAddressOf() {
+    *this = nullptr;
+    return &this->handle;
+  }
 };
 
